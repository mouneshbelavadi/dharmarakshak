[Unit]
Description=DHARMARAKSHA UNO Q Kiosk Gateway & Capture Supervisor
Documentation=https://github.com/dharmaraksha/dharmaraksha
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dharmaraksha
Group=dharmaraksha
WorkingDirectory=/opt/dharmaraksha/apps/uno-gateway

# Protected environment configuration (never world-readable)
EnvironmentFile=/etc/dharmaraksha/uno-gateway.env
Environment=NODE_ENV=production
Environment=UNO_GATEWAY_PORT=5000

# Executable invocation using pinned Node.js runtime
ExecStart=/usr/bin/node dist/index.js

# Supervised restart backoff
Restart=always
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Process Sandboxing & Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/dharmaraksha/storage /var/log/dharmaraksha

# Device permissions for UVC document camera and USB/Bridge RFID reader
SupplementaryGroups=video dialout plugdev
DeviceAllow=/dev/video0 rwm
DeviceAllow=/dev/ttyACM0 rwm

# Resource bounds on ARM64 UNO Q Linux MPU
MemoryMax=256M
MemoryHigh=200M
CPUQuota=80%

# Standard logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dharmaraksha-gateway

[Install]
WantedBy=multi-user.target

