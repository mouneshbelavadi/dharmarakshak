# DHARMARAKSHA — Safe Placeholder Configuration
# Copy this file to .env before starting local development

# Network Ports
MAIN_API_PORT=4000
MAIN_API_URL=http://localhost:4000
UNO_GATEWAY_PORT=5000
UNO_GATEWAY_URL=http://localhost:5000
LAPTOP_WEB_PORT=3000
PHONE_WEB_PORT=3001

# Central Database (PostgreSQL)
DATABASE_URL=postgresql://dharmaraksha_user:dharmaraksha_pass@localhost:5432/dharmaraksha_db

# Device Authentication (Board-to-API communication key)
DHARMARAKSHA_DEVICE_API_KEY=dharmaraksha_device_key_placeholder_safe_default

# External AI & Speech Services (Held securely on main backend, never client-side)
GEMINI_API_KEY=placeholder_gemini_api_key_for_legal_reasoning
SARVAM_API_KEY=placeholder_sarvam_api_key_for_indian_tts_stt

# Notification & Delivery Integrations
TELEGRAM_BOT_TOKEN=placeholder_telegram_bot_token
GMAIL_SENDER_ADDRESS=placeholder_sender@example.com
GMAIL_APP_PASSWORD=placeholder_app_specific_password
GOOGLE_DRIVE_CLIENT_ID=placeholder_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=placeholder_google_drive_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/drive/callback

# ─── Phase 08: Tunnel & Phone Pairing (UNO Q board-side) ────────────────────
# TUNNEL_MODE: 'ngrok' (default), 'lan_https', or 'mock_tunnel' (software-only tests)
TUNNEL_MODE=ngrok

# NGROK_AUTHTOKEN: Board-side only. NEVER expose this in phone-facing responses,
# QR codes, pairing URLs, or any client-visible resource.
# Store on board in /etc/dharmaraksha/uno-gateway.env, not in web bundle.
NGROK_AUTHTOKEN=placeholder_ngrok_authtoken

# PUBLIC_HTTPS_URL: The ngrok public HTTPS URL for the kiosk.
# Update this whenever ngrok restarts with a new URL (free plan).
# With a reserved domain (paid), this is stable across restarts.
PUBLIC_HTTPS_URL=https://your-kiosk.ngrok-free.app

# DEVICE_ID: Identifier for this UNO Q board (used in pairing and heartbeat).
DEVICE_ID=uno-q-kiosk-01

# PAIRING_CODE_LIFETIME_MINUTES: How long a generated one-time code remains valid.
PAIRING_CODE_LIFETIME_MINUTES=10

# PHONE_SESSION_LIFETIME_HOURS: How long a paired phone session remains active.
PHONE_SESSION_LIFETIME_HOURS=8

# LAN HTTPS alternative (use when ngrok is unavailable on the demo network).
# Plain HTTP on the LAN IP is insufficient for phone microphone access.
# Generate a self-signed cert or use mkcert for local trust:
#   mkcert 192.168.1.100
ALLOWED_LAPTOP_LAN_IP=192.168.1.100
LAN_HTTPS_CERT_PATH=/etc/dharmaraksha/tls/cert.pem
LAN_HTTPS_KEY_PATH=/etc/dharmaraksha/tls/key.pem

# EXTRA_ALLOWED_ORIGINS: Comma-separated additional allowed CORS origins.
# Use in integration tests only; leave empty in production.
EXTRA_ALLOWED_ORIGINS=

STORAGE_LOCAL_DIR=./storage/documents

