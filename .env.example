# ═══════════════════════════════════════════════════════════════════════════════
# DHARMARAKSHA — Environment Configuration Specification (Specification S8)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application Identity & Server Ports ──────────────────────────────────────
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
PORT=5001

# ─── Central Persistence & Database ──────────────────────────────────────────
DATABASE_URL=postgresql://dharmaraksha_admin:dharmaraksha_dev_password@localhost:5432/dharmaraksha_db
STORAGE_LOCAL_ROOT=./storage/private_cases
ENCRYPTION_KEY=dharmaraksha_secure_scrypt_aes256_key_example

# ─── Device Authentication & UNO Q Kiosk ──────────────────────────────────────
DHARMARAKSHA_DEVICE_API_KEY=dharmaraksha_device_key_uno_q_kiosk_01
DEVICE_ID=uno-q-kiosk-01
GATEWAY_PORT=5000
ALLOWED_LAPTOP_LAN_IP=192.168.1.100

# ─── AI Providers (Stored Centrally on Backend — Never Sent to Browser) ──────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ANALYSIS_MODEL=gemini-1.5-pro
GEMINI_OCR_MODEL=gemini-1.5-flash
GEMINI_LIVE_ENDPOINT=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContent

SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v1

# ─── Third-Party Integrations ────────────────────────────────────────────────
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Gmail SMTP App Password (Dedicated Sending Account)
GMAIL_USER=notifications@yourdomain.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Google Drive Direct OAuth2
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/v1/drive/callback

# ─── Concurrency & Quotas ────────────────────────────────────────────────────
GLOBAL_CONCURRENCY_QUOTA=4
PER_CASE_CONCURRENCY_QUOTA=2
MAX_PAGES_PER_DOCUMENT=50
MAX_UPLOAD_BYTE_SIZE=26214400
